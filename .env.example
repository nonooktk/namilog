# なみログ ルート .env.example（キー名と説明のみ・秘匿値は空。セキュリティ規定1）
# 実際の値は各サブディレクトリの .env（backend/.env, frontend/.env）に設定します。
# このファイルは「どんな環境変数が必要か」の一覧としての役割です。

# --- Supabase（`supabase start` の出力から控える）---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ローカル既定の DB 接続文字列（例: postgresql://postgres:postgres@127.0.0.1:54322/postgres）
SUPABASE_DB_URL=
# JWT 検証用。ローカル既定は HS256 共有シークレット。本番は JWKS（非対称鍵）を推奨。
SUPABASE_JWT_SECRET=

# --- Google OAuth（Supabase Auth の Google プロバイダ。supabase start 前に環境へ読み込む）---
# Client ID は公開情報、Secret は秘匿（コミット・Slack 禁止）。手順は docs/GOOGLE_OAUTH.md
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- バッチ内部トークン（NL-API-16/17・M3 のバッチ保護。秘匿）---
BATCH_INTERNAL_TOKEN=

# --- OpenAI（M3 で使用。M2 では未使用）---
OPENAI_API_KEY=
