# なみログ frontend .env.example（キー名と説明のみ・秘匿値は空。セキュリティ規定1）
# コピーして frontend/.env を作り、`supabase start` の出力値を設定します（.env はコミット禁止）。
# NEXT_PUBLIC_ 接頭辞の値はブラウザに露出するため、anon 鍵のみを置く（service_role は絶対に置かない）。

# Supabase（認証のみに使用。DB 直読みはしない＝P-1）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI のベース URL（全データアクセスの入口）
NEXT_PUBLIC_API_BASE=http://localhost:8000
