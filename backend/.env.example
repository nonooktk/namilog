# なみログ backend .env.example（キー名と説明のみ・秘匿値は空。セキュリティ規定1）
# コピーして backend/.env を作り、`supabase start` の出力値を設定します（.env はコミット禁止）。

# 実行環境。local / test 以外（production / staging 等）では JWT 構成の安全性を起動時に強制する。
APP_ENV=local

# Supabase ローカル API（`supabase start` の API URL）
SUPABASE_URL=
# anon 鍵（フロント用。バックエンドでは主に参照用）
SUPABASE_ANON_KEY=
# service_role 鍵（バックエンド専用・RLS 迂回。フロントに絶対露出しない）
SUPABASE_SERVICE_ROLE_KEY=
# DB 直結（RLS を効かせるため postgres で接続し SET LOCAL ROLE authenticated を用いる）
# ローカル既定: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
# JWT 検証（ローカル既定は HS256 共有シークレット）。本番は JWKS（非対称鍵）を推奨。
SUPABASE_JWT_SECRET=
# 本番で JWKS 検証に切り替える場合のみ設定（例: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json）
SUPABASE_JWKS_URL=

# CORS 許可オリジン（カンマ区切り）。フロント（Next.js）の URL。
CORS_ORIGINS=http://localhost:3000

# バッチ用内部エンドポイント（NL-API-16/17）を保護する内部トークン（秘匿・M3 で使用）。
# cron 呼び出し側と共有し、リクエストの X-Batch-Token ヘッダで照合する（fail-closed）。
BATCH_INTERNAL_TOKEN=

# OpenAI（M3・日次予測/コメント要約/FB応答/埋め込み）。未設定でも起動・テストは通る（LLM 機能のみ degrade）。
# 実キーは統括提供後に設定する。キー無しで「実 GPT 確認済み」とは記録しない。
OPENAI_API_KEY=
# 以下は任意（既定値あり）。互換 API・モデル差し替え時のみ設定する。
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EXTERNAL_HTTP_TIMEOUT=30
